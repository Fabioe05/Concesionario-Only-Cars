# Copia este archivo como .env y completa los valores reales.
# .env está ignorado por Git; nunca subas contraseñas al repositorio.

# Servidor
PORT=3000
NODE_ENV=development

# Base de datos (el nombre conserva la compatibilidad con el proyecto)
MONGO_URI_TEST=mongodb+srv://usuario:contraseña@cluster.mongodb.net/concesionario

# Firma de los JWT
ACCESS_TOKEN_SECRET=cadena-larga-y-aleatoria

# Correo (Gmail con contraseña de aplicación, sin OAuth)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=tu-correo@gmail.com
SMTP_PASS=tu-contraseña-de-aplicacion
MAIL_FROM=Only Cars <tu-correo@gmail.com>
MAIL_TO=tu-correo@gmail.com

# URL pública usada en los botones de los correos.
# En local: http://localhost:3000
# En Render: https://concesionario-only-cars.onrender.com
# Si no se define en Render, el backend usa RENDER_EXTERNAL_URL.
APP_URL=http://localhost:3000
